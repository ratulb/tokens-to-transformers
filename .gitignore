_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
# pixi environments
.pixi/*
!.pixi/config.toml
# validation outputs (regenerated by `pixi run validate`)
validate/ch01/out/*
# Chapter 4 weights (regenerated by `pixi run python validate/ch04/fetch_gpt2.py`)
validate/ch04/data/*

# python bytecode
__pycache__/
*.pyc

# editor scratch files. `git add -A` during a session where vim has a swap
# file open will otherwise commit it -- which happened once.
*.swp
*.swo
*~

# compiled Mojo binaries (`mojo build` output; rebuild with run_faults.sh)
/train_instruction

# Chapter 7 checkpoint (1.4 GB; regenerated by training)
validate/ch07/data/*.npy

/generate_instruction

/infer
